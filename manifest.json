{
  "manifest_version": 3,
  "name": "llm-gif-waiter",
  "version": "1.0.0",
  "description": "Injects GIFs into LLM interfaces while waiting for a response.",
  "icons": {
    "16": "icons/base_icon.png",
    "48": "icons/base_icon.png",
    "128": "icons/base_icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://aistudio.google.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://copilot.microsoft.com/*",
        "*://duck.ai/*",
        "*://gemini.google.com/*",
        "*://grok.com/*",
        "*://*.meta.ai/*",
        "*://notebook.google.com/notebook/*",
        "*://www.perplexity.ai/*",
        "*://poe.com/*"
      ],
      "css": ["payload/style.css"],
      "js": [
        "core/srcregistry.js",
        "core/srcproviders/chatgpt.js",
        "core/srcproviders/claude.js",
        "core/srcproviders/deepseek.js",
        "core/srcproviders/duck-ai.js",
        "core/srcproviders/gemini-notebook.js",
        "core/srcproviders/gemini.js",
        "core/srcproviders/google-ai-studio.js",
        "core/srcproviders/grok.js",
        "core/srcproviders/meta-ai.js",
        "core/srcproviders/microsoft-copilot.js",
        "core/srcproviders/perplexity.js",
        "core/srcproviders/poe.js",
        "core/srcinjector.js",
        "payload/index.js"
      ],
      "run_at": "document_end"
    }
  ]
}
