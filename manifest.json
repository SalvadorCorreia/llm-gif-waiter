{
  "manifest_version": 3,
  "name": "llm-wait-injector",
  "version": "1.0.0",
  "description": "Injects content into LLM interfaces while waiting for a response.",
  "icons": {
    "16": "icons/base_icon.png",
    "48": "icons/base_icon.png",
    "128": "icons/base_icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://aistudio.google.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://copilot.microsoft.com/*",
        "*://duck.ai/*",
        "*://gemini.google.com/*",
        "*://grok.com/*",
        "*://*.meta.ai/*",
        "*://notebook.google.com/notebook/*",
        "*://www.perplexity.ai/*",
        "*://poe.com/*"
      ],
      "css": ["payload/style.css"],
      "js": [
        "src/registry.js",
        "src/providers/chatgpt.js",
        "src/providers/claude.js",
        "src/providers/deepseek.js",
        "src/providers/duck-ai.js",
        "src/providers/gemini-notebook.js",
        "src/providers/gemini.js",
        "src/providers/google-ai-studio.js",
        "src/providers/grok.js",
        "src/providers/meta-ai.js",
        "src/providers/microsoft-copilot.js",
        "src/providers/perplexity.js",
        "src/providers/poe.js",
        "src/injector.js",
        "payload/index.js"
      ],
      "run_at": "document_end"
    }
  ]
}
