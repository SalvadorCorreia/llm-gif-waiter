{
  "manifest_version": 3,
  "name": "llm-gif-waiter",
  "version": "1.0.0",
  "description": "Injects GIFs into LLM interfaces while waiting for a response.",
  "icons": {
    "16": "icons/base_icon.png",
    "48": "icons/base_icon.png",
    "128": "icons/base_icon.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "menu/menu.html",
    "default_title": "GIF Waiter Settings"
  },
  "options_ui": {
    "page": "menu/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "core/src/analytics-worker.js",
    "scripts": ["core/src/analytics-worker.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://aistudio.google.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://copilot.microsoft.com/*",
        "*://duck.ai/*",
        "*://gemini.google.com/*",
        "*://grok.com/*",
        "*://*.meta.ai/*",
        "*://notebook.google.com/notebook/*",
        "*://www.perplexity.ai/*",
        "*://poe.com/*"
      ],
      "css": ["payload/style.css"],
      "js": [
        "core/src/registry.js",
        "core/src/settings.js",
        "core/src/providers/chatgpt.js",
        "core/src/providers/claude.js",
        "core/src/providers/deepseek.js",
        "core/src/providers/duck-ai.js",
        "core/src/providers/gemini-notebook.js",
        "core/src/providers/gemini.js",
        "core/src/providers/google-ai-studio.js",
        "core/src/providers/grok.js",
        "core/src/providers/meta-ai.js",
        "core/src/providers/microsoft-copilot.js",
        "core/src/providers/perplexity.js",
        "core/src/providers/poe.js",
        "core/src/injector.js",
        "payload/index.js"
      ],
      "run_at": "document_end"
    }
  ]
}
